{
  "name": "bat-innovation",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["frontend", "electron"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "setup:electron": "install-electron",
    "dev": "npm run build && npm run start --workspace electron",
    "build": "npm run build --workspace frontend && npm run build --workspace electron",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.tests.json",
    "test": "npm run build && node --test electron/tests/backend.test.cjs",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
